# star-hash at ~10 fps; always on (a stopped shader disappears instead of freezing).
textures a

startgroup
    animation_step 100
    var float STAR_CELL 26.0
    var float STAR_DENSITY 0.35
    var float STAR_BRIGHT 0.36
    var float STAR_SPEED 3.0
    var float STAR_FAR_SCALE 0.55
    var float STAR_FAR_SPEED 0.35
    shaders star-hash
endgroup
