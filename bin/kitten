#!/bin/bash
# Pressing M in `kitten themes` writes current-theme.conf, then the kitten
# restores the previous palette on exit. Reload the config over the control
# socket afterwards so the saved theme sticks. `kitten theme` is the same kitten.

REAL="$HOME/Applications/kitty.app/Contents/MacOS/kitten"

case "${1:-}" in
  theme|themes) ;;
  *) exec "$REAL" "$@" ;;
esac

"$REAL" "$@" || exit
# Let the theme kitten finish restoring the old palette, then replace it.
sleep 0.4
"$REAL" @ load-config || echo "kitten: theme was saved, but Kitty did not reload" >&2
